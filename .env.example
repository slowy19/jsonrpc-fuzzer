# ============================================================
#  Basic settings (required)
# ============================================================

ORIGIN=http://127.0.0.1:8080
# Path appended to ORIGIN to build the JSON-RPC endpoint URL.
# Default: /api
API_PATH=/api


# ============================================================
#  Main auth profile (optional)
#
#  Credentials used by test_fuzz_method.
#  If NOTHING here is set — the fuzz test runs anonymously.
#
#  Configure with EITHER one of the "static" options
#  OR the "login flow" option. Do not mix.
# ============================================================

# --- Option 1: static header (e.g. API key / Bearer) ---
# Note the quotes: values with spaces must be quoted.
AUTH_HEADER='Authorization: Bearer YOUR_TOKEN'

# --- Option 2: static cookie ---
AUTH_COOKIE='access_token=YOUR_TOKEN'

# --- Option 3: login flow (username/password → token) ---
AUTH_LOGIN_URL=http://127.0.0.1:8080/login
AUTH_LOGIN=admin
AUTH_PASSWORD=admin_password

# Dot-path to the token inside the login JSON response.
# Examples: 'token', 'data.access_token', 'result.jwt'
AUTH_TOKEN_JSON_PATH=token

# How to attach the token to every request (choose at least one):
#AUTH_TOKEN_HEADER='Authorization: Bearer {token}'
AUTH_TOKEN_COOKIE='access_token={token}'

# Optional: if you set this, login is sent as POST with this JSON body
# instead of GET with HTTP Basic. Placeholders {login} / {password}
# are substituted. No need to escape the JSON braces.
AUTH_LOGIN_BODY_TEMPLATE='{"username":"{login}","password":"{password}"}'


# ============================================================
#  No-permissions auth profile (optional)
#
#  Credentials for test_permissions (BOLA check).
#  If NOTHING here is set — test_permissions is skipped.
#
#  Same structure as the main profile above.
# ============================================================

# --- Option 1: static header ---
NOPERM_HEADER='Authorization: Bearer TOKEN_NO_PERM'

# --- Option 2: static cookie ---
NOPERM_COOKIE='access_token=TOKEN_NO_PERM'

# --- Option 3: login flow ---
NOPERM_LOGIN_URL=http://127.0.0.1:8080/login
NOPERM_LOGIN=user_without_permissions
NOPERM_PASSWORD=user_password

NOPERM_TOKEN_JSON_PATH=token
NOPERM_TOKEN_HEADER='Authorization: Bearer {token}'
NOPERM_TOKEN_COOKIE='access_token={token}'
NOPERM_LOGIN_BODY_TEMPLATE='{"username":"{login}","password":"{password}"}'